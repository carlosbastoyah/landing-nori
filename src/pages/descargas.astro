---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHeading from '../components/layout/PageHeading.astro';
import { DESKTOP_DOWNLOADS_URL, WEB_APP_URL, WHATSAPP_URL } from '../data/content';

const breadcrumb = [{ label: 'Inicio', href: '/' }, { label: 'Descargas' }];
---

<MarketingLayout
	title="Descargar Nori para Windows y Mac | App de escritorio"
	description="Descarga la app de escritorio de Nori para Windows y Mac o úsala desde el navegador. Software para laboratorios clínicos y de patología."
	breadcrumb={breadcrumb}
>
	<PageHeading title="Descarga Nori" breadcrumb={breadcrumb} />

	<section class="cs-section-gap">
		<div class="cs-container">
			<p class="mx-auto mb-12 max-w-2xl text-center text-lg leading-relaxed text-ash-700">
				Instala la app de escritorio o entra desde el navegador. Usas la misma cuenta y la misma información en
				ambas.
			</p>

			<div class="grid gap-8 lg:grid-cols-3">
				<article class="cs-card flex flex-col p-8" data-platform-card="windows">
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ink-deep text-white">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M3 5.5 10.5 4.5v7H3v-6Zm8.5-1.1L21 3v8.5h-9.5V4.4ZM3 12.5h7.5v7L3 18.5v-6Zm8.5 0H21V21l-9.5-1.4v-7.1Z"
							></path>
						</svg>
					</span>
					<h2 class="mt-6 text-2xl font-semibold text-ink">Windows</h2>
					<p class="mt-2 text-sm text-ash-700">Windows 10 y 11 · 64 bits</p>
					<p class="mt-4 flex-1 leading-relaxed text-ash-700">
						Instalador para el equipo de tu laboratorio. La app se actualiza sola cuando hay una versión nueva.
					</p>
					<p class="mt-6 min-h-6 text-sm text-ash-700" data-release-info="windows/x86_64" aria-live="polite"></p>
					<a
						href={WHATSAPP_URL}
						class="cs-btn-template mt-4 justify-center"
						data-download="windows/x86_64"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Descargar para Windows</span>
					</a>
					<p class="mt-3 hidden text-sm text-red-700" data-download-error="windows/x86_64">
						No pudimos obtener el instalador. Inténtalo de nuevo o
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">escríbenos</a>.
					</p>
				</article>

				<article class="cs-card flex flex-col p-8" data-platform-card="mac">
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-mint-300 text-ink">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-3.8ZM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4Z"
							></path>
						</svg>
					</span>
					<h2 class="mt-6 text-2xl font-semibold text-ink">macOS</h2>
					<p class="mt-2 text-sm text-ash-700">Mac con Apple Silicon (M1 o posterior)</p>
					<p class="mt-4 flex-1 leading-relaxed text-ash-700">
						Abre el archivo descargado y arrastra Nori a Aplicaciones. ¿Tu Mac es Intel? Usa Nori desde el navegador o
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">escríbenos</a>.
					</p>
					<p class="mt-6 min-h-6 text-sm text-ash-700" data-release-info="darwin/aarch64" aria-live="polite"></p>
					<a
						href={WHATSAPP_URL}
						class="cs-btn-template mt-4 justify-center"
						data-download="darwin/aarch64"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Descargar para Mac</span>
					</a>
					<p class="mt-3 hidden text-sm text-red-700" data-download-error="darwin/aarch64">
						No pudimos obtener el instalador. Inténtalo de nuevo o
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">escríbenos</a>.
					</p>
				</article>

				<article class="cs-card flex flex-col p-8" data-platform-card="web">
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ocean-700 text-white">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
							<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" stroke="currentColor" stroke-width="1.6"
							></path>
						</svg>
					</span>
					<h2 class="mt-6 text-2xl font-semibold text-ink">Navegador</h2>
					<p class="mt-2 text-sm text-ash-700">Chrome, Edge o Safari</p>
					<p class="mt-4 flex-1 leading-relaxed text-ash-700">
						Sin instalar nada. Ideal para recepción, consulta de resultados y acceso desde cualquier sede.
					</p>
					<a href={WEB_APP_URL} class="cs-btn-outline mt-10 justify-center">Abrir Nori web</a>
				</article>
			</div>

			<div class="mx-auto mt-14 hidden max-w-3xl cs-card p-8" data-release-notes-wrap>
				<h2 class="text-xl font-semibold text-ink">Novedades de la versión <span data-release-version></span></h2>
				<p class="mt-3 leading-relaxed whitespace-pre-line text-ash-700" data-release-notes></p>
			</div>
		</div>
	</section>
</MarketingLayout>

<script define:vars={{ downloadsUrl: DESKTOP_DOWNLOADS_URL }}>
	// The backend answers with a presigned S3 link that expires after an hour, so a fresh one is
	// requested whenever the cached one is close to expiring.
	const MAX_AGE_MS = 45 * 60 * 1000;
	const releases = new Map();

	async function fetchRelease(platform) {
		const cached = releases.get(platform);
		if (cached && Date.now() - cached.fetchedAt < MAX_AGE_MS) return cached;
		const response = await fetch(`${downloadsUrl}/${platform}`, { cache: 'no-store' });
		if (response.status !== 200) throw Object.assign(new Error(`HTTP ${response.status}`), { status: response.status });
		const release = { ...(await response.json()), fetchedAt: Date.now() };
		releases.set(platform, release);
		return release;
	}

	const dateFormat = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });

	document.querySelectorAll('[data-download]').forEach(async (button) => {
		const platform = button.dataset.download;
		const info = document.querySelector(`[data-release-info="${platform}"]`);
		const error = document.querySelector(`[data-download-error="${platform}"]`);

		button.addEventListener('click', async (event) => {
			event.preventDefault();
			error?.classList.add('hidden');
			try {
				const release = await fetchRelease(platform);
				window.location.href = release.url;
			} catch {
				error?.classList.remove('hidden');
			}
		});

		try {
			const release = await fetchRelease(platform);
			const size = release.size_bytes ? ` · ${(release.size_bytes / 1048576).toFixed(0)} MB` : '';
			if (info) info.textContent = `Versión ${release.version} · ${dateFormat.format(new Date(release.pub_date))}${size}`;
			const notesWrap = document.querySelector('[data-release-notes-wrap]');
			if (release.notes && notesWrap) {
				notesWrap.querySelector('[data-release-version]').textContent = release.version;
				notesWrap.querySelector('[data-release-notes]').textContent = release.notes;
				notesWrap.classList.remove('hidden');
			}
		} catch (err) {
			// 404: no published release ships an installer for this platform yet.
			if (err.status === 404) {
				button.classList.add('hidden');
				if (info) info.textContent = 'Aún no disponible. Mientras tanto usa Nori desde el navegador.';
			}
			// Otherwise the button still requests the installer on click; only the version label is missing.
		}
	});
</script>
