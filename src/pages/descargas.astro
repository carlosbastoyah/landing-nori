---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHeading from '../components/layout/PageHeading.astro';
import Accordion from '../components/ui/Accordion.astro';
import { WEB_APP_URL, WHATSAPP_URL } from '../data/content';

const breadcrumb = [{ label: 'Inicio', href: '/' }, { label: 'Descargas' }];

const installSteps = [
	{
		id: 'windows',
		title: 'Instalar en Windows',
		steps: [
			'Descarga el instalador y ábrelo desde la carpeta Descargas.',
			'Si Windows muestra el aviso de SmartScreen, elige «Más información» y luego «Ejecutar de todas formas».',
			'Sigue el asistente y abre Nori desde el menú Inicio o el acceso directo del escritorio.',
		],
	},
	{
		id: 'mac',
		title: 'Instalar en Mac',
		steps: [
			'Descarga el archivo .dmg y ábrelo con doble clic.',
			'Arrastra el ícono de Nori a la carpeta Aplicaciones.',
			'Abre Nori desde Aplicaciones o Launchpad. Si macOS pide confirmación, elige «Abrir».',
		],
	},
];

const downloadFaqs = [
	{
		question: '¿La app de escritorio y la web usan la misma cuenta?',
		answer:
			'Sí. Inicias sesión con el mismo usuario y ves la misma información, sincronizada en tiempo real, en la app de escritorio y en el navegador.',
	},
	{
		question: '¿Cómo se actualiza la app?',
		answer:
			'La app revisa si hay una versión nueva y se actualiza sola. No necesitas volver a descargar el instalador.',
	},
	{
		question: 'Mi Mac tiene procesador Intel, ¿puedo usar Nori?',
		answer:
			'La app para Mac requiere Apple Silicon (M1 o posterior). En una Mac con Intel puedes usar Nori desde Chrome, Edge o Safari con todas sus funciones.',
	},
	{
		question: '¿Qué hago si la descarga no inicia?',
		answer:
			'Recarga la página e inténtalo de nuevo. Si el problema continúa, escríbenos por WhatsApp y te ayudamos con la instalación.',
	},
];

const schema = [
	{
		'@type': 'SoftwareApplication',
		name: 'Nori',
		applicationCategory: 'BusinessApplication',
		applicationSubCategory: 'Sistema de información de laboratorio (LIS)',
		operatingSystem: 'Windows 10, Windows 11, macOS (Apple Silicon), Web',
		downloadUrl: new URL('/descargas/', Astro.site ?? Astro.url).toString(),
	},
	{
		'@type': 'FAQPage',
		mainEntity: downloadFaqs.map((faq) => ({
			'@type': 'Question',
			name: faq.question,
			acceptedAnswer: { '@type': 'Answer', text: faq.answer },
		})),
	},
];
---

<MarketingLayout
	title="Descargar Nori para Windows y Mac | App de escritorio"
	description="Descarga la app de escritorio de Nori para Windows y Mac o úsala desde el navegador. Software para laboratorios clínicos y de patología."
	breadcrumb={breadcrumb}
	schema={schema}
>
	<PageHeading title="Descarga Nori" breadcrumb={breadcrumb} />

	<section class="cs-section-gap">
		<div class="cs-container">
			<p class="mx-auto mb-12 max-w-2xl text-center text-lg leading-relaxed text-ash-700">
				Instala la app de escritorio o entra desde el navegador. Usas la misma cuenta y la misma información en
				ambas.
			</p>

			<div class="grid gap-8 lg:grid-cols-3">
				<article id="windows" class="cs-card relative flex scroll-mt-32 flex-col p-8" data-platform-card="windows">
					<span data-recommended-badge class="absolute top-6 right-6 rounded-full bg-mint-300 px-3 py-1 text-xs font-semibold text-ink">
						Recomendado para tu equipo
					</span>
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ink-deep text-white">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M3 5.5 10.5 4.5v7H3v-6Zm8.5-1.1L21 3v8.5h-9.5V4.4ZM3 12.5h7.5v7L3 18.5v-6Zm8.5 0H21V21l-9.5-1.4v-7.1Z"
							></path>
						</svg>
					</span>
					<h2 class="mt-6 text-2xl font-semibold text-ink">Windows</h2>
					<p class="mt-2 text-sm text-ash-700">Windows 10 y 11 · 64 bits</p>
					<p class="mt-4 flex-1 leading-relaxed text-ash-700">
						Instalador para el equipo de tu laboratorio. La app se actualiza sola cuando hay una versión nueva.
					</p>
					<p class="mt-6 min-h-6 text-sm text-ash-700" data-release-info="windows/x86_64" aria-live="polite"></p>
					<a
						href={WHATSAPP_URL}
						class="cs-btn-template mt-4 justify-center"
						data-download="windows/x86_64"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Descargar para Windows</span>
					</a>
					<p class="mt-3 hidden text-sm text-red-700" data-download-error="windows/x86_64">
						No pudimos obtener el instalador. Inténtalo de nuevo o
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">escríbenos</a>.
					</p>
				</article>

				<article id="mac" class="cs-card relative flex scroll-mt-32 flex-col p-8" data-platform-card="mac">
					<span data-recommended-badge class="absolute top-6 right-6 rounded-full bg-mint-300 px-3 py-1 text-xs font-semibold text-ink">
						Recomendado para tu equipo
					</span>
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-mint-300 text-ink">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-3.8ZM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4Z"
							></path>
						</svg>
					</span>
					<h2 class="mt-6 text-2xl font-semibold text-ink">macOS</h2>
					<p class="mt-2 text-sm text-ash-700">Mac con Apple Silicon (M1 o posterior)</p>
					<p class="mt-4 flex-1 leading-relaxed text-ash-700">
						Abre el archivo descargado y arrastra Nori a Aplicaciones. ¿Tu Mac es Intel? Usa Nori desde el navegador o
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">escríbenos</a>.
					</p>
					<p class="mt-6 min-h-6 text-sm text-ash-700" data-release-info="darwin/aarch64" aria-live="polite"></p>
					<a
						href={WHATSAPP_URL}
						class="cs-btn-template mt-4 justify-center"
						data-download="darwin/aarch64"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Descargar para Mac</span>
					</a>
					<p class="mt-3 hidden text-sm text-red-700" data-download-error="darwin/aarch64">
						No pudimos obtener el instalador. Inténtalo de nuevo o
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">escríbenos</a>.
					</p>
				</article>

				<article id="web" class="cs-card relative flex scroll-mt-32 flex-col p-8" data-platform-card="web">
					<span data-recommended-badge class="absolute top-6 right-6 rounded-full bg-mint-300 px-3 py-1 text-xs font-semibold text-ink">
						Recomendado para tu equipo
					</span>
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ocean-700 text-white">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
							<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" stroke="currentColor" stroke-width="1.6"
							></path>
						</svg>
					</span>
					<h2 class="mt-6 text-2xl font-semibold text-ink">Navegador</h2>
					<p class="mt-2 text-sm text-ash-700">Chrome, Edge o Safari</p>
					<p class="mt-4 flex-1 leading-relaxed text-ash-700">
						Sin instalar nada. Ideal para recepción, consulta de resultados y acceso desde cualquier sede.
					</p>
					<a href={WEB_APP_URL} class="cs-btn-outline mt-10 justify-center">Abrir Nori web</a>
				</article>
			</div>

			<div class="mx-auto mt-14 hidden max-w-3xl cs-card p-8" data-release-notes-wrap>
				<h2 class="text-xl font-semibold text-ink">Novedades de la versión <span data-release-version></span></h2>
				<p class="mt-3 leading-relaxed whitespace-pre-line text-ash-700" data-release-notes></p>
			</div>
		</div>
	</section>

	<section class="bg-paper py-20 lg:py-24">
		<div class="cs-container">
			<div class="mx-auto mb-12 max-w-2xl text-center">
				<h2 class="cs-section-title">Instálala en menos de dos minutos</h2>
				<p class="mt-4 leading-relaxed text-ash-700">Tres pasos y tu equipo queda listo para trabajar.</p>
			</div>
			<div class="grid gap-8 lg:grid-cols-2">
				{
					installSteps.map((guide) => (
						<div class="cs-card p-8 lg:p-10">
							<h3 class="text-xl font-semibold text-ink">{guide.title}</h3>
							<ol class="mt-6 space-y-5">
								{guide.steps.map((step, index) => (
									<li class="flex gap-4">
										<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-deep text-sm font-semibold text-white">
											{index + 1}
										</span>
										<span class="pt-1 leading-relaxed text-ash-700">{step}</span>
									</li>
								))}
							</ol>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="cs-section-gap">
		<div class="cs-container">
			<div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
				<div>
					<h2 class="cs-section-title">Preguntas sobre la instalación</h2>
					<p class="mt-5 leading-relaxed text-ash-700">
						¿Necesitas ayuda para instalar Nori en los equipos de tu laboratorio? Nuestro equipo te acompaña.
					</p>
					<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="cs-btn-template mt-8">
						<span>Pedir ayuda por WhatsApp</span>
					</a>
				</div>
				<Accordion items={downloadFaqs} variant="template" />
			</div>
		</div>
	</section>
</MarketingLayout>

<script>
	import '../scripts/desktop-downloads';
</script>
