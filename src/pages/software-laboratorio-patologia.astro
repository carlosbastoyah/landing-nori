---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SolutionPage from '../components/sections/SolutionPage.astro';
import SectionEyebrow from '../components/ui/SectionEyebrow.astro';
import { pathologySiblings } from '../data/pathology';
import { standardPlans, formatMoney } from '../data/pricing';
import desktopLaminillas from '../assets/mockups/desktop-laminillas.png';
import desktopPlantilla from '../assets/mockups/desktop-plantilla-reporte.png';

const breadcrumb = [{ label: 'Inicio', href: '/' }, { label: 'Software de patología' }];

const features = [
	{
		title: 'Casos de anatomía patológica',
		description:
			'Registra biopsias, citologías y piezas quirúrgicas con expediente, tipo de caso, médico solicitante y sucursal. Marca urgencias e imprime las etiquetas de cada muestra.',
	},
	{
		title: 'Visor de laminillas',
		description:
			'Escanea o sube laminillas, navega con zoom, marca hallazgos por región y adjunta las figuras directamente al informe.',
	},
	{
		title: 'Editor de diagnóstico',
		description:
			'Captura descripción macroscópica y diagnóstico con revisión ortográfica, fotos del caso y vista previa del informe en tiempo real.',
	},
	{
		title: 'Plantillas de informe',
		description:
			'Diseña tus formatos de reporte con logo, datos de la sucursal y variables del paciente y del médico. Versiones con o sin fotografía.',
	},
	{
		title: 'CRM de médicos y clientes',
		description:
			'Administra a los médicos que te refieren casos, tus pacientes y clientes, sus convenios y el seguimiento de cada relación.',
	},
	{
		title: 'Cobro y facturación',
		description:
			'Controla qué casos están pagados o por cobrar, con precios por estudio. Facturación integrada próximamente.',
	},
];

const steps = [
	{
		title: 'Recepción',
		description: 'Registra al paciente, el médico solicitante y los estudios. Imprime las etiquetas de la muestra.',
	},
	{
		title: 'Procesamiento',
		description: 'Sigue el caso de recibido a en proceso, con laminillas escaneadas y hallazgos anotados.',
	},
	{
		title: 'Diagnóstico',
		description: 'Redacta el diagnóstico sobre tu plantilla y revisa el informe antes de completarlo.',
	},
	{
		title: 'Entrega',
		description: 'Exporta el informe en PDF o Word y registra la entrega y el pago del caso.',
	},
];

const studyGroups = [
	{
		title: 'Histopatología y biopsias',
		items: ['Biopsias por trucut, sacabocado o endoscópicas', 'Piezas quirúrgicas neoplásicas y no neoplásicas', 'Transoperatorios', 'Revisión de bloques y laminillas'],
	},
	{
		title: 'Citología',
		items: ['Papanicolaou convencional y en base líquida', 'BAAF de tiroides, mama, ganglio y tejidos blandos', 'Líquidos corporales y cepillados', 'Secreciones y extendidos'],
	},
	{
		title: 'Técnicas complementarias',
		items: ['Inmunohistoquímica y anticuerpos', 'Tinciones especiales (PAS, Masson, Grocott, Z.N.)', 'PCR en citología y biopsia', 'Estudios que agregues a tu catálogo'],
	},
];

const reasons = [
	{
		title: 'Precios públicos',
		description: 'Consulta los planes en nuestra página de precios sin tener que pedir una cotización.',
	},
	{
		title: 'Web y escritorio',
		description: 'Trabaja desde el navegador o con la app para Windows y macOS, con la misma cuenta y la misma información.',
	},
	{
		title: 'Tu formato de siempre',
		description: 'Replica tu formato de informe actual en el editor de plantillas para que tus médicos referentes reciban lo que ya conocen.',
	},
	{
		title: 'Varias sucursales',
		description: 'Cada caso queda ligado a su sucursal y el informe muestra los datos de quien lo emite.',
	},
	{
		title: 'Soporte por WhatsApp',
		description: 'Habla directo con nuestro equipo en México para resolver dudas o pedir ajustes.',
	},
	{
		title: 'Clínico y patología juntos',
		description: 'Si también haces análisis clínicos, manejas ambas áreas en el mismo sistema.',
	},
];

const entryPlan = standardPlans[0];

const faqs = [
	{
		question: '¿Qué es un software de patología?',
		answer:
			'Es un sistema de información de laboratorio (LIS) diseñado para anatomía patológica: registra cada caso desde la recepción de la muestra, sigue su procesamiento, permite redactar el diagnóstico sobre una plantilla y entrega el informe al médico o al paciente. Sustituye libretas, hojas de cálculo y documentos de Word sueltos.',
	},
	{
		question: '¿Nori sirve para citología, biopsias y BAAF?',
		answer:
			'Sí. Puedes configurar tu catálogo con estudios de citología exfoliativa (Papanicolaou convencional y en base líquida), citología diversa como BAAF de tiroides, glándula mamaria o ganglio, biopsias e histopatología, cada uno con su categoría y precio.',
	},
	{
		question: '¿Puedo manejar inmunohistoquímica y tinciones especiales?',
		answer:
			'Sí. Inmunohistoquímica, anticuerpos, tinciones especiales y PCR se registran como estudios de tu catálogo, con su propio precio, y se agregan al caso del paciente.',
	},
	{
		question: '¿Puedo usar los formatos de reporte que ya tengo?',
		answer:
			'Sí. El editor de plantillas te permite replicar tu formato actual con tu logo, encabezados, secciones de descripción macroscópica y diagnóstico, y variables que se llenan solas con los datos del paciente, el médico y la sucursal.',
	},
	{
		question: '¿Puedo agregar imágenes de las laminillas al informe?',
		answer:
			'Sí. Desde el visor de laminillas marcas hallazgos y los adjuntas como figuras al informe. También puedes subir fotos generales del caso.',
	},
	{
		question: '¿Funciona para laboratorios con varias sucursales?',
		answer:
			'Sí. Cada caso queda asociado a su sucursal, y las plantillas de informe pueden mostrar los datos de la sucursal que lo emite.',
	},
	{
		question: '¿Se usa en web o hay que instalar algo?',
		answer:
			'Puedes usar Nori desde el navegador sin instalar nada o con la app de escritorio. Ambas comparten la misma cuenta y la misma información.',
	},
	{
		question: '¿Cuánto cuesta el software de patología?',
		answer:
			`Nori se contrata por suscripción mensual desde ${formatMoney(entryPlan.monthlyBasePrice!)} MXN más IVA en el plan ${entryPlan.name}, que incluye ${entryPlan.includedStudies} estudios al mes. Todos los planes están publicados en la página de precios. Agenda una demo y te ayudamos a elegir el que corresponde al volumen de tu laboratorio.`,
	},
	{
		question: '¿Cómo empiezo a usarlo?',
		answer:
			'Agenda una demo por WhatsApp. Te mostramos el sistema con el flujo de tu laboratorio, configuramos tu catálogo de estudios y tus plantillas de informe, y empiezas a registrar casos.',
	},
];

const faqSchema = {
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};
---

<MarketingLayout
	title="Software de patología para laboratorios de anatomía patológica | Nori"
	description="Software de patología (LIS) para biopsias, citologías e inmunohistoquímica: visor de laminillas, plantillas de informe, multi-sucursal y cobro. Precios públicos. Agenda una demo."
	breadcrumb={breadcrumb}
	schema={[faqSchema]}
>
	<SolutionPage
		eyebrow="Anatomía patológica"
		title="Software de patología para laboratorios de anatomía patológica"
		intro="Nori es el sistema LIS que organiza cada biopsia, citología y pieza quirúrgica desde la recepción hasta la entrega del informe: laminillas, diagnóstico, plantillas y cobro en un solo sistema, en web y escritorio."
		heroImage={{
			src: desktopLaminillas,
			alt: 'Software de patología Nori: visor de laminillas con anotaciones sobre una biopsia',
		}}
		features={features}
		steps={steps}
		detailImage={{
			src: desktopPlantilla,
			alt: 'Editor de plantillas de informe de anatomía patológica en Nori',
		}}
		detailTitle="Informes de patología con tu formato, sin copiar y pegar"
		detailText="Crea plantillas de reporte con tu logo y tus secciones. Los datos del paciente, el médico, la sucursal y el caso se llenan solos, y el patólogo solo se enfoca en el diagnóstico."
		detailPoints={[
			'Variables automáticas de paciente, médico y sucursal',
			'Secciones de descripción macroscópica y diagnóstico',
			'Figuras de laminillas adjuntas al informe',
			'Exportación a PDF y Word',
		]}
		faqs={faqs}
		related={{ href: '/software-laboratorio-clinico/', label: 'Nori para laboratorios clínicos' }}
		subpages={pathologySiblings('/software-laboratorio-patologia/')}
		subpagesTitle="Funciones del software de patología"
	>
		<section class="pb-20 lg:pb-28">
			<div class="cs-container">
				<div class="mx-auto mb-12 max-w-2xl text-center">
					<SectionEyebrow label="Estudios" class="justify-center" />
					<h2 class="cs-section-title mt-5">Los estudios de patología que manejas en Nori</h2>
					<p class="mt-5 leading-relaxed text-ash-700">
						Arma tu catálogo con los estudios que realiza tu laboratorio, cada uno con su categoría y precio.
					</p>
				</div>
				<div class="grid gap-6 md:grid-cols-3">
					{
						studyGroups.map((group) => (
							<article class="cs-card p-8">
								<h3 class="text-xl font-semibold text-ink">{group.title}</h3>
								<ul class="mt-4 space-y-2 text-ash-700">
									{group.items.map((item) => (
										<li class="flex items-start gap-2">
											<span class="text-ocean-700" aria-hidden="true">•</span>
											<span>{item}</span>
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="bg-[#ecf1f5] py-20 lg:py-28 mb-20 lg:mb-28">
			<div class="cs-container">
				<div class="mx-auto mb-12 max-w-2xl text-center">
					<SectionEyebrow label="Por qué Nori" class="justify-center" />
					<h2 class="cs-section-title mt-5">¿Por qué elegir Nori como software de patología?</h2>
				</div>
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{
						reasons.map((reason) => (
							<article class="cs-card p-8">
								<h3 class="text-xl font-semibold text-ink">{reason.title}</h3>
								<p class="mt-3 leading-relaxed text-ash-700">{reason.description}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>
	</SolutionPage>
</MarketingLayout>
