---
import Layout from '../layouts/Layout.astro';

const painPoints = [
	{
		title: 'Trazabilidad fragmentada',
		description:
			'Casos, muestras y reportes viven en sistemas distintos. Eso retrasa decisiones clinicas y aumenta errores operativos.',
	},
	{
		title: 'Demasiado trabajo manual',
		description:
			'Validaciones, seguimiento y comunicacion requieren demasiados pasos repetitivos que consumen tiempo del equipo.',
	},
	{
		title: 'Falta de visibilidad ejecutiva',
		description:
			'Sin indicadores claros en tiempo real, es dificil detectar cuellos de botella y crecer con control.',
	},
];

const features = [
	{
		title: 'Gestion de casos y estudios',
		description: 'Desde recepcion hasta validacion final, con historial completo y estados visibles para todo el equipo.',
		image: '/nori/illustrations/feature-cases.svg',
	},
	{
		title: 'Flujos inteligentes',
		description: 'Reglas de negocio, alertas y asignaciones automaticas para reducir tiempos de entrega.',
		image: '/nori/illustrations/feature-flows.svg',
	},
	{
		title: 'Colaboracion clinica',
		description: 'Comentarios y seguimiento entre area clinica, laboratorio y administracion en un solo lugar.',
		image: '/nori/illustrations/feature-collab.svg',
	},
	{
		title: 'Reporteria personalizable',
		description: 'Paneles por rol para direccion, coordinacion y operacion con KPIs accionables.',
		image: '/nori/illustrations/feature-reports.svg',
	},
];

const steps = [
	{
		title: 'Captura y priorizacion',
		description: 'Registra solicitudes, adjunta archivos y organiza urgencias con reglas claras.',
	},
	{
		title: 'Revision y diagnostico',
		description: 'Consolida informacion del paciente y del estudio para validar cada caso con contexto.',
	},
	{
		title: 'Entrega y seguimiento',
		description: 'Comparte reportes, deja evidencia de cambios y mide tiempos por etapa.',
	},
	{
		title: 'Mejora continua',
		description: 'Analiza metricas historicas para optimizar operacion y escalar con confianza.',
	},
];
---

<Layout
	title="Nori | Software para laboratorios clinicos y de patologia"
	description="Centraliza casos, automatiza flujos y acelera reportes clinicos con una plataforma moderna para laboratorios clinicos y de patologia."
	image="/nori/uploads/app-estudios.png"
>
	<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300">
		<div class="wrap flex h-20 items-center justify-between gap-4">
			<a href="#top" class="flex items-center gap-3 no-underline" aria-label="Nori inicio">
				<img src="/nori/logo-nori-text.svg" alt="Nori" class="logo-glow h-7 w-auto sm:h-8" width="168" height="52" />
			</a>

			<nav class="hidden items-center gap-8 text-sm font-medium lg:flex">
				<a href="#producto" class="text-mint-100/80 transition hover:text-white">Producto</a>
				<a href="#flujo" class="text-mint-100/80 transition hover:text-white">Flujo</a>
				<a href="#seguridad" class="text-mint-100/80 transition hover:text-white">Seguridad</a>
				<a href="#clientes" class="text-mint-100/80 transition hover:text-white">Resultados</a>
			</nav>

			<div class="flex items-center gap-2">
				<a href="https://api.whatsapp.com/send/?phone=529994533797&text=Hola%2C+quiero+conocer+m%C3%A1s+sobre+la+plataforma+para+laboratorios+cl%C3%ADnicos+y+de+patolog%C3%ADa.&type=phone_number&app_absent=0" target="_blank" rel="noopener noreferrer" class="btn hidden border-2 border-white/75 bg-mint-500 px-7 py-3.5 text-ink-deep shadow-[0_10px_24px_-14px_rgba(169,224,195,0.85)] hover:-translate-y-0.5 hover:bg-mint-300 sm:inline-flex">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.32 4.94L2 22l5.2-1.36a9.96 9.96 0 0 0 4.84 1.23h.01c5.52 0 10-4.48 10-10s-4.48-9.87-10.01-9.87Zm5.86 14.3c-.25.7-1.45 1.33-2 1.42-.51.08-1.15.11-1.86-.12-.43-.13-.98-.32-1.69-.62-2.97-1.28-4.9-4.28-5.05-4.48-.15-.2-1.21-1.6-1.21-3.06s.76-2.16 1.03-2.46c.27-.29.59-.37.79-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.08.92 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.47.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.24.67-.15.27.1 1.75.82 2.05.97.3.15.5.22.57.35.08.13.08.75-.17 1.45Z"/></svg>
					WhatsApp
				</a>
				<a href="tel:+529994533797" class="btn btn-primary">Hablar con ventas</a>
			</div>
		</div>
	</header>

	<script>
		const header = document.getElementById('site-header');
		if (header) {
			const onScroll = () => {
				const scrolled = window.scrollY > 40;
				header.classList.toggle('bg-ink-deep/92', scrolled);
				header.classList.toggle('backdrop-blur-md', scrolled);
				header.classList.toggle('border-white/12', scrolled);
				header.classList.toggle('border-transparent', !scrolled);
			};
			onScroll();
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	</script>

	<main id="top">
		<section class="hero-ink-stage relative overflow-hidden">
			<div aria-hidden="true" class="hero-curve pointer-events-none absolute inset-y-0 right-0 hidden w-1/3 lg:block">
				<svg viewBox="0 0 100 115" preserveAspectRatio="none" class="h-full w-full">
					<defs>
						<linearGradient id="heroCurveFill" x1="0" y1="0" x2="0.5" y2="1">
							<stop offset="0%" stop-color="#f7fdfb"></stop>
							<stop offset="52%" stop-color="#d9f0e4"></stop>
							<stop offset="100%" stop-color="#eef7f5"></stop>
						</linearGradient>
					</defs>
					<path fill="url(#heroCurveFill)" d="M100,0 L0,0 C0,14 17,26 20,41 C23,56 11,69 9,82 C8,96 18,107 24,115 L100,115 Z"></path>
				</svg>
			</div>

			<div class="wrap relative z-10 grid grid-cols-1 gap-12 pt-32 pb-24 lg:min-h-screen lg:grid-cols-2 lg:items-center lg:gap-8 lg:pt-36 lg:pb-28">
				<div class="fade-up">
					<span class="inline-flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.14em] text-mint-300 uppercase">
						<span class="h-1.5 w-1.5 rounded-full bg-mint-300"></span> Software para laboratorios clínicos y de patología
					</span>
					<h1 class="mt-5 max-w-[15ch] text-4xl leading-tight font-semibold text-white md:text-6xl">
						Gestiona estudios, casos y doctores sin depender de Excel ni papel
					</h1>
					<p class="mt-6 max-w-[42ch] text-lg leading-relaxed text-mint-100/85">
						Recepción de estudios, casos clínicos, convenios por doctor y resultados en un solo sistema, con datos en tiempo real y trazabilidad completa.
					</p>
					<div class="mt-9 flex flex-wrap items-center gap-3">
						<a href="#cta" class="btn border-mint-300 bg-mint-500 text-ink-deep hover:bg-mint-300">Agenda una demo</a>
						<a href="#producto" class="btn btn-light">Conocer la app</a>
					</div>
				</div>

				<div class="fade-up-delay relative mx-auto max-w-2xl lg:mx-0 lg:max-w-none">
					<div class="relative z-10 overflow-hidden rounded-2xl md:-translate-y-20 lg:ml-8 lg:rounded-[1rem]">
						<img
							src="/nori/screenshot-dashboard.png"
							alt="Panel web de Nori con el resumen operativo del laboratorio"
							class="aspect-[16/10] w-full object-cover object-left-top"
							width="1600"
							height="1000"
							fetchpriority="high"
						/>
					</div>
					<img
						src="/nori/mockops/phones-login-dashboard.png"
						alt="Telefonos con la app movil de Nori mostrando el panel principal"
						class="absolute -right-4 -bottom-12 z-20 w-44 drop-shadow-2xl sm:w-52 lg:-right-[5%] lg:-bottom-24 lg:w-72 xl:w-90"
						width="3488"
						height="3668"
					/>
				</div>
			</div>
		</section>

		<section class="editorial-stage relative py-20 md:py-28">
			<div class="wrap">
				<div class="mx-auto max-w-3xl text-center">
					<span class="eyebrow justify-center">El problema actual</span>
					<h2 class="mt-4 text-3xl md:text-5xl">Cuando la operacion depende de hojas sueltas, la precision se vuelve un riesgo</h2>
				</div>
				<div class="mt-12 grid gap-5 lg:grid-cols-[1fr_1fr_1fr]">
					{painPoints.map((item, idx) => (
						<article class="card rounded-2xl p-6">
							<div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-mint-100 text-sm font-mono font-semibold text-ocean-700">0{idx + 1}</div>
							<h3 class="mt-4 text-xl">{item.title}</h3>
							<p class="mt-3 leading-relaxed text-ash-700">{item.description}</p>
						</article>
					))}
					<!-- <article class="card hidden overflow-hidden rounded-2xl p-2 lg:block">
						<img src="/nori/illustrations/cards-scene.svg" alt="Ilustracion abstracta de tarjetas y paneles Nori" class="h-full w-full rounded-xl object-cover" width="880" height="560" />
					</article> -->
				</div>
			</div>
			<div aria-hidden="true" class="absolute inset-x-0 bottom-[-1px] overflow-hidden leading-none text-[#f8fbf8]">
				<svg viewBox="0 0 1440 120" class="h-18 w-full md:h-24" preserveAspectRatio="none"><path fill="currentColor" d="M0,32L80,48C160,64,320,96,480,106.7C640,117,800,107,960,90.7C1120,75,1280,53,1360,42.7L1440,32V120H1360C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120H0Z"></path></svg>
			</div>
		</section>

		<section id="producto" class="peach-stage melt-from-light relative overflow-hidden py-20 md:py-28">
			<div aria-hidden="true" class="nori-dots pointer-events-none absolute inset-0 opacity-20"></div>
			<div class="wrap relative">
				<div class="mx-auto max-w-3xl text-center">
					<span class="eyebrow justify-center">Producto Nori</span>
					<h2 class="mt-4 text-3xl md:text-5xl">Todo lo que tu laboratorio necesita para operar sin fricciones</h2>
				</div>

				<div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
					{features.map((item) => (
						<article class="card overflow-hidden rounded-2xl p-0">
							<img src={item.image} alt={item.title} class="h-44 w-full object-cover" width="960" height="640" />
							<div class="p-6">
								<div class="mb-3 h-1.5 w-12 rounded-full bg-gradient-to-r from-mint-500 to-ocean-700"></div>
								<h3 class="text-xl">{item.title}</h3>
								<p class="mt-3 leading-relaxed text-ash-700">{item.description}</p>
							</div>
						</article>
					))}
				</div>

				<div class="mt-10 grid gap-5 md:grid-cols-2">
					<div class="overflow-hidden rounded-3xl">
						<img
							src="/nori/uploads/app-estudios.png"
							alt="Vista de seguimiento de estudios en Nori"
							class="h-full w-full object-cover"
							width="3680"
							height="2228"
						/>
					</div>
					<div class="overflow-hidden rounded-3xl">
						<img
							src="/nori/uploads/app-plantillas.png"
							alt="Plantillas de reportes y documentos en Nori"
							class="h-full w-full object-cover"
							width="3680"
							height="2228"
						/>
					</div>
				</div>
			</div>
			<div aria-hidden="true" class="absolute inset-x-0 bottom-[-1px] overflow-hidden leading-none text-[#103f47]">
				<svg viewBox="0 0 1440 120" class="h-18 w-full md:h-24" preserveAspectRatio="none"><path fill="currentColor" d="M0,64L80,80C160,96,320,128,480,122.7C640,117,800,75,960,58.7C1120,43,1280,53,1360,58.7L1440,64V120H1360C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120H0Z"></path></svg>
			</div>
		</section>

		<section class="ink-stage melt-from-peach relative overflow-hidden py-20 text-white md:py-28">
			<div class="wrap relative grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
				<div>
					<span class="eyebrow text-mint-300">Gestion sin friccion</span>
					<h2 class="mt-4 text-3xl text-white md:text-5xl">Automatiza el trabajo repetitivo y libera tiempo clinico de alto valor</h2>
					<p class="mt-6 text-lg leading-relaxed text-mint-100/90">
						Configura reglas por especialidad, define niveles de prioridad y manten un seguimiento transparente en cada etapa del caso.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href="#cta" class="btn border-mint-300 bg-mint-500 text-ink-deep hover:bg-mint-300">Solicitar propuesta</a>
						<a href="#flujo" class="btn btn-light">Conocer el flujo</a>
					</div>
				</div>
				<div class="card overflow-hidden rounded-3xl border-white/15 bg-white/5 p-2">
					<img src="/nori/illustrations/trust-scene.svg" alt="Ilustracion editorial de confianza y eficiencia en Nori" class="h-full w-full rounded-2xl object-cover" width="880" height="560" />
				</div>
			</div>
			<div aria-hidden="true" class="absolute inset-x-0 bottom-[-1px] overflow-hidden leading-none text-[#fbfefd]">
				<svg viewBox="0 0 1440 120" class="h-18 w-full md:h-24" preserveAspectRatio="none"><path fill="currentColor" d="M0,96L80,80C160,64,320,32,480,26.7C640,21,800,43,960,58.7C1120,75,1280,85,1360,90.7L1440,96V120H1360C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120H0Z"></path></svg>
			</div>
		</section>

		<section id="flujo" class="relative overflow-hidden bg-white py-20 md:py-28">
			<div class="wrap">
				<div class="grid items-end gap-6 lg:grid-cols-[0.9fr_1.1fr]">
					<div>
						<span class="eyebrow">Flujo operativo</span>
						<h2 class="mt-4 max-w-[13ch] text-3xl md:text-5xl">De la solicitud al dictamen en un camino claro y medible</h2>
					</div>
					<p class="max-w-xl text-lg leading-relaxed text-ash-700 lg:justify-self-end">Cada etapa deja una señal visible para que el equipo sepa qué sigue, quién responde y cuándo intervenir.</p>
				</div>
				<div class="relative mt-14 grid gap-0 border-t border-line md:grid-cols-2 xl:grid-cols-4">
					<div aria-hidden="true" class="absolute top-[-3px] left-0 hidden h-1 w-full bg-gradient-to-r from-mint-500 via-ocean-500 to-ink xl:block"></div>
					{steps.map((step, idx) => (
						<article class="relative border-b border-line px-0 py-8 md:border-r md:px-6 xl:border-b-0 xl:px-7 xl:first:pl-0 xl:last:border-r-0 xl:last:pr-0">
							<div class="flex items-center gap-3 text-ocean-700">
								<span class="font-mono text-sm font-semibold">0{idx + 1}</span>
								<span class="h-px flex-1 bg-line xl:hidden"></span>
							</div>
							<h3 class="mt-6 text-2xl leading-tight">{step.title}</h3>
							<p class="mt-4 leading-relaxed text-ash-700">{step.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="seguridad" class="relative bg-paper py-20 md:py-28">
			<div class="wrap grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-20">
				<div class="max-w-xl">
					<span class="eyebrow">Seguridad y cumplimiento</span>
					<h2 class="mt-4 text-3xl md:text-5xl">Confianza para el equipo medico y para direccion</h2>
					<p class="mt-6 text-lg leading-relaxed text-ash-700">
						Controles de acceso por rol, trazabilidad de cambios y respaldo seguro de informacion sensible para mantener calidad operativa y cumplimiento.
					</p>
					<ul class="mt-8 divide-y divide-line border-y border-line text-ash-700">
						<li class="py-4 font-medium">Control granular de permisos por perfil</li>
						<li class="py-4 font-medium">Historial auditable en cada caso</li>
						<li class="py-4 font-medium">Estandarizacion de reportes y formatos</li>
					</ul>
					<div class="mt-8 border-l-2 border-mint-500 pl-5">
						<p class="text-xs font-semibold tracking-[0.1em] text-ocean-700 uppercase">Operacion visible y controlada</p>
						<p class="mt-2 text-base leading-relaxed text-ash-700">Cada cambio queda registrado para que el equipo pueda responder con contexto y seguridad.</p>
					</div>
				</div>

				<div class="relative mx-auto h-[430px] w-full max-w-xl sm:h-[500px]">
					<img src="/nori/doctor-1.png" alt="Especialista de laboratorio usando Nori" class="absolute top-0 left-1/2 z-20 h-[66%] w-auto -translate-x-1/2 object-contain" width="1024" height="1024" />
					<img src="/nori/doctor-2.png" alt="Medica revisando informacion clinica" class="absolute bottom-0 left-[4%] z-10 h-[48%] w-auto object-contain sm:left-[8%]" width="1024" height="1024" />
					<img src="/nori/doctor-3.png" alt="Profesional de salud trabajando con Nori" class="absolute right-[4%] bottom-0 z-10 h-[48%] w-auto object-contain sm:right-[8%]" width="1024" height="1024" />
				</div>
			</div>
		</section>

		<section id="clientes" class="editorial-stage melt-from-dark relative py-20 md:py-24">
			<div class="wrap">
				<div class="text-center">
				<span class="eyebrow justify-center">Casos reales</span>
				<h2 class="mx-auto mt-4 max-w-3xl text-3xl md:text-5xl">Laboratorios que necesitaban orden, hoy operan con claridad</h2>
				</div>
				<div class="testimonial-slider mt-10 overflow-hidden" aria-label="Testimonios de laboratorios aliados">
					<div class="testimonial-track flex w-max gap-5">
						<div class="testimonial-card card w-[min(86vw,430px)] shrink-0 rounded-2xl p-7 text-left">
							<img src="/nori/uploads/Capay_logo.svg" alt="Capay" class="h-10 w-auto" width="330" height="113" />
							<p class="mt-6 text-lg leading-relaxed text-ash-700">"Con Nori redujimos tiempo administrativo, tenemos visibilidad del avance por caso y el equipo medico puede concentrarse en lo importante."</p>
							<p class="mt-5 text-sm font-semibold text-ink">Direccion de Operaciones, laboratorio aliado</p>
						</div>
						<div class="testimonial-card card w-[min(86vw,430px)] shrink-0 rounded-2xl p-7 text-left">
							<p class="text-sm font-semibold tracking-[0.12em] text-ocean-700 uppercase">Laboratorio aliado</p>
							<p class="mt-6 text-lg leading-relaxed text-ash-700">"Ahora cada estudio tiene un responsable y un estado claro. El equipo responde con mas rapidez y menos seguimiento manual."</p>
							<p class="mt-5 text-sm font-semibold text-ink">Coordinacion clinica</p>
						</div>
						<div class="testimonial-card card w-[min(86vw,430px)] shrink-0 rounded-2xl p-7 text-left">
							<p class="text-sm font-semibold tracking-[0.12em] text-ocean-700 uppercase">Laboratorio aliado</p>
							<p class="mt-6 text-lg leading-relaxed text-ash-700">"La trazabilidad en tiempo real nos permite anticipar retrasos y tomar decisiones con la informacion completa."</p>
							<p class="mt-5 text-sm font-semibold text-ink">Direccion medica</p>
						</div>
						<div class="testimonial-card card w-[min(86vw,430px)] shrink-0 rounded-2xl p-7 text-left" aria-hidden="true">
							<img src="/nori/uploads/Capay_logo.svg" alt="" class="h-10 w-auto" width="330" height="113" />
							<p class="mt-6 text-lg leading-relaxed text-ash-700">"Con Nori redujimos tiempo administrativo, tenemos visibilidad del avance por caso y el equipo medico puede concentrarse en lo importante."</p>
							<p class="mt-5 text-sm font-semibold text-ink">Direccion de Operaciones, laboratorio aliado</p>
						</div>
						<div class="testimonial-card card w-[min(86vw,430px)] shrink-0 rounded-2xl p-7 text-left" aria-hidden="true">
							<p class="text-sm font-semibold tracking-[0.12em] text-ocean-700 uppercase">Laboratorio aliado</p>
							<p class="mt-6 text-lg leading-relaxed text-ash-700">"Ahora cada estudio tiene un responsable y un estado claro. El equipo responde con mas rapidez y menos seguimiento manual."</p>
							<p class="mt-5 text-sm font-semibold text-ink">Coordinacion clinica</p>
						</div>
						<div class="testimonial-card card w-[min(86vw,430px)] shrink-0 rounded-2xl p-7 text-left" aria-hidden="true">
							<p class="text-sm font-semibold tracking-[0.12em] text-ocean-700 uppercase">Laboratorio aliado</p>
							<p class="mt-6 text-lg leading-relaxed text-ash-700">"La trazabilidad en tiempo real nos permite anticipar retrasos y tomar decisiones con la informacion completa."</p>
							<p class="mt-5 text-sm font-semibold text-ink">Direccion medica</p>
						</div>
					</div>
				</div>
			</div>
			<div aria-hidden="true" class="absolute inset-x-0 bottom-[-1px] overflow-hidden leading-none text-[#103f47]">
				<svg viewBox="0 0 1440 120" class="h-18 w-full md:h-24" preserveAspectRatio="none"><path fill="currentColor" d="M0,54L80,48C160,43,320,32,480,42.7C640,53,800,85,960,96C1120,107,1280,96,1360,90.7L1440,85V120H1360C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120H0Z"></path></svg>
