---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHeading from '../components/layout/PageHeading.astro';
import { Image } from 'astro:assets';
import screenshotDashboard from '../assets/mockups/screenshot-dashboard.png';
import { WHATSAPP_URL, WHATSAPP_PHONE, PHONE_URL, COMPANY } from '../data/content';

const breadcrumb = [{ label: 'Inicio', href: '/' }, { label: 'Contacto' }];
---

<MarketingLayout
	title="Contacto y demo | Nori, software para laboratorios"
	breadcrumb={breadcrumb}
	description="Contáctanos para agendar una demo de Nori. WhatsApp, teléfono y formulario de contacto para laboratorios clínicos."
>
	<PageHeading title="Contáctanos" breadcrumb={breadcrumb} />

	<section class="cs-section-gap">
		<div class="cs-container">
			<div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
				<div class="cs-card p-8">
					<h2 class="text-2xl font-semibold text-ink">Envíanos un mensaje</h2>
					<p class="mt-3 text-ash-700">Cuéntanos sobre tu laboratorio y te responderemos en menos de 24 horas.</p>
					<form class="mt-8 space-y-5" id="contact-form" data-phone={WHATSAPP_PHONE}>
						<div>
							<label for="name" class="mb-2 block text-sm font-medium text-ink">Nombre</label>
							<input
								type="text"
								id="name"
								name="name"
								autocomplete="name"
								required
								class="w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition focus:border-mint-500 focus:ring-2 focus:ring-mint-300/40"
								placeholder="Tu nombre"
							/>
						</div>
						<div>
							<label for="email" class="mb-2 block text-sm font-medium text-ink">Correo electrónico</label>
							<input
								type="email"
								id="email"
								name="email"
								autocomplete="email"
								required
								class="w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition focus:border-mint-500 focus:ring-2 focus:ring-mint-300/40"
								placeholder="tu@laboratorio.com"
							/>
						</div>
						<div>
							<label for="message" class="mb-2 block text-sm font-medium text-ink">Mensaje</label>
							<textarea
								id="message"
								name="message"
								rows="4"
								required
								class="w-full resize-none rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition focus:border-mint-500 focus:ring-2 focus:ring-mint-300/40"
								placeholder="Cuéntanos sobre tu laboratorio y qué necesitas..."></textarea>
						</div>
						<button type="submit" class="cs-btn-dark">
							<span>Enviar por WhatsApp</span>
							<span class="cs-btn-icon" aria-hidden="true">
								<svg width="14" height="12" viewBox="0 0 14 12" fill="none">
									<path
										d="M1 6H13M13 6L8 1M13 6L8 11"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</span>
						</button>
						<p class="text-xs text-ash-700">
							Se abrirá WhatsApp con tu mensaje listo para enviar. Al enviarlo aceptas nuestro
							<a href="/aviso-de-privacidad/" class="underline hover:text-ink">aviso de privacidad</a>.
						</p>
					</form>
				</div>

				<div>
					<h2 class="text-2xl font-semibold text-ink">Información de contacto</h2>
					<p class="mt-3 text-ash-700">Estamos disponibles para resolver tus dudas y agendar una demo personalizada.</p>

					<div class="mt-8 space-y-6">
						<div class="cs-iconbox">
							<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-mint-300 text-ink">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.32 4.94L2 22l5.2-1.36a9.96 9.96 0 0 0 4.84 1.23h.01c5.52 0 10-4.48 10-10s-4.48-9.87-10.01-9.87Z"
										fill="currentColor"></path>
								</svg>
							</span>
							<div>
								<h3 class="font-semibold text-ink">WhatsApp</h3>
								<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="text-ocean-700 hover:underline"
									>{COMPANY.phone}</a
								>
							</div>
						</div>
						<div class="cs-iconbox">
							<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-ink-deep text-white">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M6.6 10.8a15.05 15.05 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.36 11.36 0 0 0 3.56.56 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .56 3.56 1 1 0 0 1-.25 1Z"
										fill="currentColor"></path>
								</svg>
							</span>
							<div>
								<h3 class="font-semibold text-ink">Teléfono</h3>
								<a href={PHONE_URL} class="text-ocean-700 hover:underline">{COMPANY.phone}</a>
							</div>
						</div>
						<div class="cs-iconbox">
							<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-ocean-700 text-white">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
										stroke="currentColor"
										stroke-width="1.5"></path>
									<path d="M22 6 12 13 2 6" stroke="currentColor" stroke-width="1.5"></path>
								</svg>
							</span>
							<div>
								<h3 class="font-semibold text-ink">Horario</h3>
								<p class="text-ash-700">Lunes a viernes, 9:00 – 18:00 (GMT-6)</p>
							</div>
						</div>
						<div class="cs-iconbox">
							<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-mint-500 text-ink">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"
										fill="currentColor"></path>
								</svg>
							</span>
							<div>
								<h3 class="font-semibold text-ink">Domicilio fiscal</h3>
								<p class="text-ash-700">{COMPANY.formattedAddress}</p>
							</div>
						</div>
					</div>

					<div class="cs-card mt-10 p-8">
						<h3 class="text-lg font-semibold text-ink">Datos de la empresa</h3>
						<dl class="mt-4 space-y-3 text-sm">
							<div>
								<dt class="font-medium text-ink">Razón social</dt>
								<dd class="text-ash-700">{COMPANY.legalNameFull}</dd>
							</div>
							<div>
								<dt class="font-medium text-ink">RFC</dt>
								<dd class="text-ash-700">{COMPANY.rfc}</dd>
							</div>
							<div>
								<dt class="font-medium text-ink">Marca comercial</dt>
								<dd class="text-ash-700">{COMPANY.brandName}</dd>
							</div>
						</dl>
					</div>

					<div class="mt-10 overflow-hidden rounded-2xl">
						<Image
						src={screenshotDashboard}
						alt="Panel de Nori con el resumen de órdenes del laboratorio"
						class="w-full object-cover"
						widths={[480, 800, 1200]}
						sizes="(min-width: 1024px) 600px, 100vw"
						format="webp"
					/>
					</div>
				</div>
			</div>
		</div>
	</section>
</MarketingLayout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;

	if (form) {
		// The footer CTA links here with ?email=..., so carry it over
		const email = new URLSearchParams(window.location.search).get('email');
		const emailInput = form.elements.namedItem('email') as HTMLInputElement | null;
		if (email && emailInput && !emailInput.value) emailInput.value = email;

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const text = [
				'Hola, quiero información sobre Nori.',
				`Nombre: ${data.get('name')}`,
				`Correo: ${data.get('email')}`,
				'',
				String(data.get('message') ?? ''),
			].join('\n');
			const params = new URLSearchParams({ phone: form.dataset.phone ?? '', text });
			window.open(`https://api.whatsapp.com/send/?${params}`, '_blank', 'noopener');
		});
	}
</script>
