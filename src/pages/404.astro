---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Button from '../components/ui/Button.astro';
---

<MarketingLayout
	title="Página no encontrada | Nori"
	description="La página que buscas no existe o cambió de dirección."
	noindex
>
	<section class="cs-page-heading pt-32 lg:pt-40">
		<div class="cs-container">
			<p class="cs-section-subtitle"><span>Error 404</span></p>
			<h1 class="cs-section-title mt-6">No encontramos esta página</h1>
			<p class="mx-auto mt-4 max-w-xl">
				Es posible que el enlace haya cambiado. Vuelve al inicio o conoce nuestras soluciones para laboratorios.
			</p>
			<div class="mt-10 flex flex-wrap justify-center gap-4">
				<Button href="/" variant="dark">Ir al inicio</Button>
				<Button href="/software-laboratorio-clinico/" variant="outline">Laboratorio clínico</Button>
				<Button href="/software-laboratorio-patologia/" variant="outline">Patología</Button>
			</div>
		</div>
	</section>
</MarketingLayout>
