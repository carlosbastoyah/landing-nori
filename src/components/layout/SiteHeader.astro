---
import { WHATSAPP_URL } from '../../data/content';
import { mainNav, isCurrent } from '../../data/navigation';

const navLinks = mainNav.map((link) => ({ ...link, current: isCurrent(link.href, Astro.url.pathname) }));
---

<a href="#contenido" class="cs-skip-link">Saltar al contenido</a>

<header id="site-header" class="cs-site-header">
	<div class="cs-main-header">
		<div class="cs-header-container">
			<div class="cs-main-header-in">
				<div class="cs-header-shape" aria-hidden="true">
					<img src="/nori/decorative/header-shape.svg" alt="" width="1646" height="112" />
				</div>

				<div class="cs-main-header-left">
					<a href="/" class="cs-site-branding" aria-label="Nori inicio">
						<img
							src="/nori/logo-nori-mark.svg"
							alt=""
							class="cs-site-branding__mark"
							width="40"
							height="40"
						/>
						<span class="cs-site-branding__wordmark">nori</span>
					</a>
				</div>

				<div class="cs-main-header-center">
					<nav class="cs-nav" aria-label="Principal">
						<ul class="cs-nav-list">
							{
								navLinks.map((link) => (
									<li>
										<a href={link.href} aria-current={link.current ? 'page' : undefined}>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
				</div>

				<div class="cs-main-header-right">
					<a
						href={WHATSAPP_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="cs-header-cta"
					>
						<span>Agendar demo</span>
						<span class="cs-btn-icon" aria-hidden="true">
							<svg width="14" height="12" viewBox="0 0 14 12" fill="none">
								<path
									d="M1 6H13M13 6L8 1M13 6L8 11"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</span>
					</a>
				</div>

				<button
					type="button"
					id="mobile-menu-btn"
					class="cs-menu-toggle"
					aria-label="Abrir menú"
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<span></span>
				</button>
			</div>
		</div>
	</div>

	<div id="mobile-menu" class="cs-mobile-nav" inert>
		<nav aria-label="Móvil">
			{
				navLinks.map((link) => (
					<a href={link.href} aria-current={link.current ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>
		<a
			href={WHATSAPP_URL}
			target="_blank"
			rel="noopener noreferrer"
			class="cs-btn-template mt-6 no-underline"
		>
			<span>Agendar demo</span>
			<span class="cs-btn-icon" aria-hidden="true">
				<svg width="14" height="12" viewBox="0 0 14 12" fill="none">
					<path
						d="M1 6H13M13 6L8 1M13 6L8 11"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</span>
		</a>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	const desktopQuery = window.matchMedia('(min-width: 1200px)');

	function isMobileOpen() {
		return Boolean(mobileMenu?.classList.contains('is-open'));
	}

	if (header) {
		let lastScrollTop = window.scrollY;
		let ticking = false;

		const update = () => {
			ticking = false;
			if (isMobileOpen()) return;

			const windowTop = window.scrollY;
			const isSticky = windowTop >= header.offsetHeight + 20;

			header.classList.toggle('cs-gescout-sticky', isSticky);
			header.classList.toggle('cs-gescout-show', isSticky && windowTop < lastScrollTop);
			lastScrollTop = windowTop;
		};

		update();
		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			},
			{ passive: true }
		);

		// Reveal the header when keyboard focus lands inside it while it is hidden
		header.addEventListener('focusin', () => {
			if (header.classList.contains('cs-gescout-sticky')) header.classList.add('cs-gescout-show');
		});
	}

	if (menuBtn && mobileMenu) {
		const setOpen = (open: boolean) => {
			mobileMenu.classList.toggle('is-open', open);
			mobileMenu.inert = !open;
			menuBtn.classList.toggle('is-active', open);
			menuBtn.setAttribute('aria-expanded', String(open));
			menuBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			document.documentElement.style.overflow = open ? 'hidden' : '';
			if (open) {
				header?.classList.remove('cs-gescout-sticky');
				header?.classList.add('cs-gescout-show');
				mobileMenu.querySelector('a')?.focus();
			}
		};

		menuBtn.addEventListener('click', () => setOpen(!isMobileOpen()));

		mobileMenu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !isMobileOpen()) return;
			setOpen(false);
			menuBtn.focus();
		});

		// Rotating a tablet or resizing past the breakpoint must not leave the page scroll-locked
		desktopQuery.addEventListener('change', (event) => {
			if (event.matches && isMobileOpen()) setOpen(false);
		});
	}
</script>
