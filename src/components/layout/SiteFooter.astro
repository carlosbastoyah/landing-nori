---
import { WHATSAPP_URL, PHONE_URL, COMPANY, SOCIAL_URLS } from '../../data/content';

const socialIcons = {
	facebook: {
		label: 'Facebook',
		path: 'M9 8H6v4h3v12h5V12h3.6l.4-4H14V6.3c0-.9.2-1.3 1.3-1.3H18V0h-3.2C12.2 0 11 1.5 11 4.3V8z',
	},
	linkedin: {
		label: 'LinkedIn',
		path: 'M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 8.98h4v12H3V8.98zm7 0h3.8v1.7h.1c.5-1 1.8-2.1 3.7-2.1 4 0 4.7 2.6 4.7 6v6.3h-4v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H10V8.98z',
	},
	instagram: {
		label: 'Instagram',
		path: 'M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5a5 5 0 100 10 5 5 0 000-10zm6.5-.9a1.1 1.1 0 100 2.2 1.1 1.1 0 000-2.2z',
	},
};

// Profiles without a URL are hidden instead of rendering dead "#" links
const socialLinks = (Object.keys(socialIcons) as (keyof typeof socialIcons)[])
	.filter((key) => SOCIAL_URLS[key])
	.map((key) => ({ ...socialIcons[key], href: SOCIAL_URLS[key] }));
---

<footer class="cs-footer-panel text-ink" style="background-image: url('/nori/template/footer-bg-1.svg');">
	<div class="cs-container pt-[80px] pb-12 lg:pt-[130px]">
		<div class="cs-newsletter border-b border-black/10 pb-[72px]">
			<div class="max-w-[633px]">
				<h2 class="cs-section-title mb-5">Solicita una demo personalizada</h2>
				<p class="mb-0">Déjanos tu correo y te mostramos cómo Nori se adapta al flujo de tu laboratorio.</p>
			</div>
			<form class="flex max-w-[600px] flex-col items-stretch gap-4 sm:flex-row sm:items-center" action="/contacto/" method="get">
				<div class="relative flex-1">
					<label for="footer-email" class="sr-only">Correo electrónico</label>
					<span class="absolute top-1/2 left-6 -translate-y-1/2">
						<img src="/nori/template/icons/mail.svg" alt="" class="h-5 w-5 opacity-60" width="20" height="20" />
					</span>
					<input
						type="email"
						id="footer-email"
						name="email"
						autocomplete="email"
						placeholder="Tu correo electrónico"
						class="cs-newsletter-input"
						required
					/>
				</div>
				<button type="submit" class="cs-btn-template shrink-0">
					<span>Continuar</span>
					<span class="cs-btn-icon" aria-hidden="true">
						<svg width="14" height="12" viewBox="0 0 14 12" fill="none">
							<path
								d="M1 6H13M13 6L8 1M13 6L8 11"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
				</button>
			</form>
		</div>

		<div class="mt-[72px] grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
			<div>
				<a href="/" class="mb-8 inline-flex items-center gap-2.5" aria-label="Nori inicio">
					<img src="/nori/logo-nori-mark.svg" alt="" class="h-9 w-auto" width="36" height="36" loading="lazy" />
					<span class="font-brand text-[1.75rem] leading-none font-semibold tracking-[-0.03em] text-ink">nori</span>
				</a>
				<p class="mb-8 max-w-sm leading-relaxed">
					Software para laboratorios clínicos y de patología. Centraliza casos, automatiza flujos y acelera
					reportes con trazabilidad completa.
				</p>
				{
					socialLinks.length > 0 && (
						<div class="flex gap-3">
							{socialLinks.map((link) => (
								<a
									href={link.href}
									target="_blank"
									rel="noopener noreferrer me"
									class="cs-social-link"
									aria-label={link.label}
								>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d={link.path} />
									</svg>
								</a>
							))}
						</div>
					)
				}
			</div>
			<nav aria-label="Enlaces útiles">
				<h3 class="cs-footer-widget-title mb-7">Enlaces útiles</h3>
				<ul class="space-y-2.5 text-sm">
					<li><a href="/" class="transition hover:text-ink">Inicio</a></li>
					<li><a href="/#producto" class="transition hover:text-ink">Producto</a></li>
					<li><a href="/precios/" class="transition hover:text-ink">Precios</a></li>
					<li><a href="/descargas/" class="transition hover:text-ink">Descargas</a></li>
					<li><a href="/contacto/" class="transition hover:text-ink">Contacto</a></li>
				</ul>
			</nav>
			<nav aria-label="Soluciones">
				<h3 class="cs-footer-widget-title mb-7">Soluciones</h3>
				<ul class="space-y-2.5 text-sm">
					<li>
						<a href="/software-laboratorio-clinico/" class="transition hover:text-ink">Laboratorio clínico (LIS)</a>
					</li>
					<li>
						<a href="/software-laboratorio-patologia/" class="transition hover:text-ink">Laboratorio de patología</a>
					</li>
				</ul>
			</nav>
			<nav aria-label="Ayuda y soporte">
				<h3 class="cs-footer-widget-title mb-7">Ayuda y soporte</h3>
				<ul class="space-y-2.5 text-sm">
					<li><a href="/preguntas-frecuentes/" class="transition hover:text-ink">Preguntas frecuentes</a></li>
					<li><a href="/aviso-de-privacidad/" class="transition hover:text-ink">Aviso de privacidad</a></li>
					<li>
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="transition hover:text-ink"
							>WhatsApp</a
						>
					</li>
					<li><a href={PHONE_URL} class="transition hover:text-ink">{COMPANY.phone}</a></li>
				</ul>
			</nav>
			<div>
				<h3 class="cs-footer-widget-title mb-7">Comienza hoy</h3>
				<div class="flex flex-col gap-3">
					<a
						href={WHATSAPP_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="cs-btn-template justify-center whitespace-nowrap"
					>
						<span>Agendar demo</span>
						<span class="cs-btn-icon" aria-hidden="true">
							<svg width="14" height="12" viewBox="0 0 14 12" fill="none">
								<path
									d="M1 6H13M13 6L8 1M13 6L8 11"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
	<div class="py-[22px]">
		<div class="cs-container space-y-2 text-center text-sm">
			<p>
				{COMPANY.brandName} es un producto de <strong>{COMPANY.legalNameFull}</strong> (RFC {COMPANY.rfc}).
			</p>
			<address class="text-ash-700 not-italic">
				{COMPANY.formattedAddress} · <a href={PHONE_URL} class="hover:text-ink">{COMPANY.phone}</a>
			</address>
			<p>© {new Date().getFullYear()} {COMPANY.legalName}. Todos los derechos reservados.</p>
		</div>
	</div>
</footer>
