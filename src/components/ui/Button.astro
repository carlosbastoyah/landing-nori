---
interface Props {
	href: string;
	variant?: 'primary' | 'dark' | 'outline';
	class?: string;
	target?: string;
	rel?: string;
	ariaLabel?: string;
}

const { href, variant = 'primary', class: className = '', target, rel, ariaLabel } = Astro.props;

const variants = {
	primary: 'cs-btn-primary',
	dark: 'cs-btn-dark',
	outline: 'cs-btn-outline',
};
---

<a
	href={href}
	class={`${variants[variant]} ${className}`}
	target={target}
	rel={rel}
	aria-label={ariaLabel}
>
	<span><slot /></span>
	<span class="cs-btn-icon" aria-hidden="true">
		<svg width="14" height="12" viewBox="0 0 14 12" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path
				d="M1 6H13M13 6L8 1M13 6L8 11"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</span>
</a>
