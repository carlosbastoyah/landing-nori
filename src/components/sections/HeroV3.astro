---
import { Image } from 'astro:assets';
import { WHATSAPP_URL } from '../../data/content';
import heroPhones from '../../assets/mockups/phones-login-dashboard.png';
---

<section class="cs-hero-style-1">
	<div
		class="cs-hero-content"
		style="background-image: url('/nori/decorative/hero-bg-1.svg');"
	>
		<div class="cs-container-wide cs-hero-inner">
			<div class="grid items-center gap-10 lg:grid-cols-12">
				<div class="order-2 lg:order-1 lg:col-span-7">
					<div class="cs-hero-text">
						<p class="cs-hero-subtitle">
							<span class="text-mint-300">
								<svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
									<path
										d="M7.5 0L9.52568 5.47432L15 7.5L9.52568 9.52568L7.5 15L5.47432 9.52568L0 7.5L5.47432 5.47432L7.5 0Z"
										fill="currentColor"></path>
								</svg>
							</span>
							<span>Software para laboratorios clínicos y de patología</span>
							<span class="text-mint-300">
								<svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
									<path
										d="M7.5 0L9.52568 5.47432L15 7.5L9.52568 9.52568L7.5 15L5.47432 9.52568L0 7.5L5.47432 5.47432L7.5 0Z"
										fill="currentColor"></path>
								</svg>
							</span>
						</p>
						<h1 class="cs-hero-title">
							Gestiona estudios, casos y doctores sin depender de Excel ni papel
						</h1>
						<p class="cs-hero-desc">
							Recepción de estudios, casos clínicos, convenios por doctor y resultados en un solo sistema, con
							datos en tiempo real y trazabilidad completa.
						</p>
						<div class="cs-btns-group">
							<a
								href={WHATSAPP_URL}
								target="_blank"
								rel="noopener noreferrer"
								class="cs-btn-mint"
							>
								<span>Agendar demo</span>
								<span class="cs-btn-icon" aria-hidden="true">
									<svg width="14" height="12" viewBox="0 0 14 12" fill="none">
										<path
											d="M1 6H13M13 6L8 1M13 6L8 11"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"></path>
									</svg>
								</span>
							</a>
							<div class="cs-client-info">
								<img
									src="/nori/template/customers-group.png"
									alt=""
									width="200"
									height="56"
									aria-hidden="true"
								/>
								<div>
									<h3 class="mb-0 text-[30px] font-semibold text-white">3.5k+</h3>
									<p class="mb-0 text-white">Casos activos</p>
								</div>
							</div>
						</div>
						<a href="#descargar" class="cs-hero-download-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
							<span>¿Ya usas Nori? Descarga la app para Windows y Mac</span>
						</a>
					</div>
				</div>
				<div class="cs-hero-thumb-col order-1 lg:order-2 lg:col-span-5">
					<div class="cs-hero-thumb">
						<Image
							src={heroPhones}
							alt="App de Nori: inicio de sesión y panel de órdenes del laboratorio"
							width={1200}
							widths={[480, 800, 1200]}
							sizes="(min-width: 1400px) 38vw, (min-width: 1024px) 42vw, 100vw"
							format="webp"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
