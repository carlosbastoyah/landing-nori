---
import { Image } from 'astro:assets';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { WEB_APP_URL } from '../../data/content';
import webEstudios from '../../assets/mockups/web-estudios.png';
import desktopLaminillas from '../../assets/mockups/desktop-laminillas.png';

const platforms = [
	{
		title: 'App web',
		description:
			'Entra desde Chrome, Edge o Safari sin instalar nada. Ideal para recepción, consulta de estudios y acceso desde cualquier sede.',
		image: webEstudios,
		alt: 'Nori en el navegador: catálogo de estudios del laboratorio',
		points: ['Sin instalación', 'Acceso desde cualquier equipo', 'Siempre en la última versión'],
		cta: { href: WEB_APP_URL, label: 'Abrir Nori web' },
	},
	{
		title: 'App de escritorio',
		description:
			'Una aplicación dedicada para el equipo del laboratorio, con su propio acceso directo y ventana, pensada para el trabajo diario.',
		image: desktopLaminillas,
		alt: 'App de escritorio de Nori: visor de laminillas con anotaciones de patología',
		points: ['Ventana y acceso directo propios', 'Se actualiza sola', 'Misma cuenta y datos que la web'],
		cta: { href: '/descargas/', label: 'Descargar para Windows o Mac' },
	},
];
---

<section id="plataformas" class="relative overflow-hidden">
	<div class="cs-spacer-120"></div>
	<div class="cs-container">
		<div class="mx-auto mb-14 max-w-2xl text-center">
			<SectionEyebrow label="Web y escritorio" class="justify-center" />
			<h2 class="cs-section-title mt-5">Usa Nori desde el navegador o como app de escritorio</h2>
			<p class="mt-5 leading-relaxed text-ash-700">
				La misma información, sincronizada en tiempo real, en la plataforma que mejor se adapte a cada área de tu
				laboratorio.
			</p>
		</div>
		<div class="grid gap-8 lg:grid-cols-2">
			{
				platforms.map((platform) => (
					<article class="cs-card flex flex-col overflow-hidden">
						<div class="aspect-[40/27] overflow-hidden bg-[#ecf1f5]">
							<Image
								src={platform.image}
								alt={platform.alt}
								class="h-full w-full object-cover"
								width={1200}
								widths={[600, 900, 1200]}
								sizes="(min-width: 1024px) 45vw, 100vw"
							/>
						</div>
						<div class="flex flex-1 flex-col p-8 lg:p-10">
							<h3 class="text-2xl font-semibold text-ink">{platform.title}</h3>
							<p class="mt-3 leading-relaxed text-ash-700">{platform.description}</p>
							<ul class="mt-6 space-y-2.5">
								{platform.points.map((point) => (
									<li class="flex items-center gap-3 text-ink">
										<img loading="lazy" decoding="async" src="/nori/template/icons/checkbox.svg" alt="" width="20" height="20" />
										<span>{point}</span>
									</li>
								))}
							</ul>
							<a href={platform.cta.href} class="cs-btn-outline mt-8 self-start">
								{platform.cta.label}
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
