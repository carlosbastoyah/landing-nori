---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import Accordion from '../ui/Accordion.astro';
import CtaBanner from './CtaBanner.astro';
import { WHATSAPP_URL } from '../../data/content';

interface Props {
	eyebrow: string;
	title: string;
	intro: string;
	heroImage: { src: ImageMetadata; alt: string };
	features: { title: string; description: string }[];
	steps: { title: string; description: string }[];
	detailImage: { src: ImageMetadata; alt: string };
	detailTitle: string;
	detailText: string;
	detailPoints: string[];
	faqs: { question: string; answer: string }[];
	related: { href: string; label: string };
}

const {
	eyebrow,
	title,
	intro,
	heroImage,
	features,
	steps,
	detailImage,
	detailTitle,
	detailText,
	detailPoints,
	faqs,
	related,
} = Astro.props;
---

<section class="cs-page-heading pt-28 lg:pt-36">
	<div class="cs-container">
		<SectionEyebrow label={eyebrow} class="justify-center" />
		<h1 class="cs-section-title mx-auto mt-5 max-w-4xl">{title}</h1>
		<p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-ash-700">{intro}</p>
		<div class="mt-8 flex flex-wrap justify-center gap-4">
			<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="cs-btn-template">
				<span>Agendar demo</span>
			</a>
			<a href="/precios/" class="cs-btn-outline">Ver planes</a>
		</div>
		<div class="mx-auto mt-14 max-w-5xl overflow-hidden rounded-[30px]">
			<Image
				src={heroImage.src}
				alt={heroImage.alt}
				class="w-full"
				width={1400}
				widths={[700, 1050, 1400]}
				sizes="(min-width: 1024px) 1024px, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<section class="cs-section-gap">
	<div class="cs-container">
		<div class="mx-auto mb-12 max-w-2xl text-center">
			<SectionEyebrow label="Funciones" class="justify-center" />
			<h2 class="cs-section-title mt-5">Todo el flujo de tu laboratorio en un solo sistema</h2>
		</div>
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				features.map((feature) => (
					<article class="cs-card p-8">
						<h3 class="text-xl font-semibold text-ink">{feature.title}</h3>
						<p class="mt-3 leading-relaxed text-ash-700">{feature.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<section class="bg-[#ecf1f5] py-20 lg:py-28">
	<div class="cs-container">
		<div class="grid items-center gap-12 lg:grid-cols-2">
			<div>
				<h2 class="cs-section-title">{detailTitle}</h2>
				<p class="mt-5 leading-relaxed text-ash-700">{detailText}</p>
				<ul class="mt-8 space-y-3">
					{
						detailPoints.map((point) => (
							<li class="flex items-start gap-3 text-ink">
								<img src="/nori/template/icons/checkbox.svg" alt="" width="20" height="20" class="mt-1" />
								<span>{point}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="overflow-hidden rounded-[30px]">
				<Image
					src={detailImage.src}
					alt={detailImage.alt}
					class="w-full"
					width={1200}
					widths={[600, 900, 1200]}
					sizes="(min-width: 1024px) 50vw, 100vw"
				/>
			</div>
		</div>
	</div>
</section>

<section class="cs-section-gap">
	<div class="cs-container">
		<div class="mx-auto mb-12 max-w-2xl text-center">
			<SectionEyebrow label="Cómo funciona" class="justify-center" />
			<h2 class="cs-section-title mt-5">De la recepción a la entrega del resultado</h2>
		</div>
		<ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step, index) => (
					<li class="cs-card p-8">
						<span class="text-sm font-semibold text-ocean-700">Paso {index + 1}</span>
						<h3 class="mt-2 text-xl font-semibold text-ink">{step.title}</h3>
						<p class="mt-3 leading-relaxed text-ash-700">{step.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<section class="pb-20 lg:pb-28">
	<div class="cs-container">
		<div class="mx-auto max-w-3xl">
			<h2 class="cs-section-title mb-10 text-center">Preguntas frecuentes</h2>
			<Accordion items={faqs} allowMultiple />
			<p class="mt-10 text-center text-ash-700">
				¿Buscas otra especialidad? Conoce también <a href={related.href} class="font-semibold text-ocean-700 hover:underline"
					>{related.label}</a
				>.
			</p>
		</div>
	</div>
</section>

<CtaBanner />
