---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import PricingCard from '../ui/PricingCard.astro';
import { pricingPlans } from '../../data/pricing';

const planIcons = [
	'/nori/template/icons/free.svg',
	'/nori/template/icons/star-1.svg',
	'/nori/template/icons/dimond.svg',
	'/nori/template/icons/crown.svg',
];
---

<section id="precios" class="relative overflow-hidden">
	<div class="cs-spacer-120"></div>
	<div class="cs-container">
		<div class="relative z-[1] mx-auto mb-[60px] max-w-2xl text-center">
			<SectionEyebrow label="Precios" class="justify-center" />
			<h2 class="cs-section-title mt-5">Planes para cada etapa de tu laboratorio</h2>
			<p class="mt-4 text-ash-700">
				Una cuota mensual más los casos que procesas, con tarifa por caso que baja conforme creces. Sin cobro por
				usuario.
			</p>
		</div>
		<div class="relative z-10 mt-14 grid gap-8 md:grid-cols-2 xl:grid-cols-4 xl:items-end">
			{pricingPlans.map((plan, index) => <PricingCard plan={plan} icon={planIcons[index]} />)}
		</div>
		<div class="mt-10 text-center">
			<a href="/precios/#calculadora" class="cs-btn-outline">Calcular el precio para mi laboratorio</a>
		</div>
		<img
			src="/nori/decorative/vector-6.svg"
			alt=""
			class="pointer-events-none absolute right-0 bottom-20 hidden w-40 opacity-30 xl:block"
			aria-hidden="true"
		/>
	</div>
	<div class="cs-spacer-120"></div>
</section>
