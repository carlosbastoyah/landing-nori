---
import { Image } from 'astro:assets';
import { WEB_APP_URL, WHATSAPP_URL } from '../../data/content';
import laptopLogin from '../../assets/mockups/laptop-login.png';

const highlights = ['Se actualiza sola', 'Misma cuenta que la web', 'Windows 10/11 y macOS'];
---

<section id="descargar" class="cs-section-gap">
	<div class="cs-container">
		<div class="cs-hero-panel px-6 py-14 sm:px-12 lg:px-16 lg:py-20">
			<div class="grid items-center gap-12 lg:grid-cols-2">
				<div class="text-center lg:text-left">
					<p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm font-medium text-mint-300">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<rect x="3" y="4" width="18" height="12" rx="2" stroke="currentColor" stroke-width="2"></rect>
							<path d="M8 20h8M12 16v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
						</svg>
						App de escritorio
					</p>
					<h2 class="cs-section-title mt-5 text-white">Nori en el escritorio de todo tu laboratorio</h2>
					<p class="mt-5 text-lg leading-relaxed text-white/80">
						Instálala en las computadoras de recepción, histología y patología. Abre con un clic, trabaja en su propia
						ventana y mantén todo sincronizado con la versión web.
					</p>

					<ul class="mt-7 flex flex-wrap justify-center gap-x-6 gap-y-3 lg:justify-start">
						{
							highlights.map((item) => (
								<li class="flex items-center gap-2 text-white">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-mint-500" aria-hidden="true">
										<circle cx="12" cy="12" r="10" fill="currentColor" opacity="0.2" />
										<path d="m7.5 12.5 3 3 6-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
									<span>{item}</span>
								</li>
							))
						}
					</ul>

					<div class="mt-9 flex flex-col items-center gap-3 lg:items-start">
						<a href="/descargas/" class="cs-btn-mint" data-download="auto">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
							<span data-download-label>Descargar la app</span>
						</a>
						<p class="min-h-6 text-sm text-white/60" data-release-info="auto" aria-live="polite"></p>
						<p class="hidden text-sm text-red-300" data-download-error="auto">
							No pudimos obtener el instalador. Inténtalo de nuevo o
							<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">escríbenos</a>.
						</p>
					</div>

					<p class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-white/70 lg:justify-start">
						<span>También disponible:</span>
						<a href="/descargas/#windows" class="font-medium text-white underline-offset-4 hover:underline" data-hide-on-platform="windows/x86_64">Windows</a>
						<a href="/descargas/#mac" class="font-medium text-white underline-offset-4 hover:underline" data-hide-on-platform="darwin/aarch64">macOS</a>
						<a href={WEB_APP_URL} class="font-medium text-white underline-offset-4 hover:underline">Navegador</a>
						<span aria-hidden="true">·</span>
						<a href="/descargas/" class="font-medium text-mint-300 underline-offset-4 hover:underline">Todas las descargas</a>
					</p>
				</div>

				<div>
					<Image
						src={laptopLogin}
						alt="App de escritorio de Nori: pantalla de inicio de sesión en una laptop"
						width={1200}
						widths={[600, 900, 1200]}
						sizes="(min-width: 1024px) 45vw, 100vw"
						class="mx-auto w-full max-w-[640px] drop-shadow-2xl"
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import '../../scripts/desktop-downloads';
</script>
