---
import { Image } from 'astro:assets';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { features, WHATSAPP_URL } from '../../data/content';
import laptopEstudios from '../../assets/mockups/laptop-estudios.png';
---

<section id="producto" class="relative overflow-hidden bg-[#f5f5f5]">
	<div class="cs-spacer-120 lg:h-[161px]"></div>
	<div class="cs-container">
		<div class="cs-card-style-1 cs-card-type-1">
			<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-y-12">
				<div class="order-2 lg:order-1">
					<div class="cs-card-content">
						<div class="mb-5">
							<SectionEyebrow label="Ventajas del producto" />
							<h2 class="cs-section-title mt-5">Todo lo que tu laboratorio necesita para operar sin fricciones</h2>
						</div>
						<p class="mb-8 leading-relaxed text-ash-700">
							Desde recepción hasta validación final, con historial completo, reglas de negocio y paneles por rol
							para cada miembro del equipo.
						</p>
						<ul class="cs-list-style-1 cs-list-grid mb-8 max-w-md">
							{
								features.map((feature) => (
									<li>
										<img loading="lazy" decoding="async" src="/nori/template/icons/checkbox.svg" alt="" width="20" height="20" />
										<h3 class="text-lg font-normal text-ink">{feature.title}</h3>
									</li>
								))
							}
						</ul>
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="cs-btn-template">
							<span>Solicitar demo</span>
							<span class="cs-btn-icon" aria-hidden="true">
								<svg width="14" height="12" viewBox="0 0 14 12" fill="none">
									<path
										d="M1 6H13M13 6L8 1M13 6L8 11"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</span>
						</a>
					</div>
				</div>
				<div class="relative order-1 lg:order-2">
					<div class="cs-card-thumb !pl-0">
						<Image
							src={laptopEstudios}
							alt="Nori en laptop: gestión de estudios del laboratorio"
							class="w-full"
							width={1200}
							widths={[600, 900, 1200]}
							sizes="(min-width: 1024px) 50vw, 100vw"
						/>
					</div>
				</div>
			</div>
		</div>
		<img loading="lazy" decoding="async" src="/nori/decorative/star-shape.svg" alt="" class="cs-deco-star-2" aria-hidden="true" />
		<img loading="lazy" decoding="async" src="/nori/decorative/star-shape.svg" alt="" class="cs-deco-star-3" aria-hidden="true" />
		<img loading="lazy" decoding="async" src="/nori/template/vector.svg" alt="" class="cs-deco-vector-2" aria-hidden="true" />
		<div class="cs-deco-elipse cs-deco-elipse-2" aria-hidden="true"></div>
		<div class="cs-deco-elipse cs-deco-elipse-3" aria-hidden="true"></div>
	</div>
	<div class="h-24 lg:h-[133px]"></div>
</section>
