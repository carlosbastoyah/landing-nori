---
import { Image } from 'astro:assets';
import capayLogo from '../../assets/clients/capay-logo.jpg';
import pdvLogo from '../../assets/clients/pdv-logo.png';

const clients = [
	{ name: 'CAPAY, Centro de Análisis Patológicos de Yucatán', logo: capayLogo },
	{ name: 'PDV', logo: pdvLogo },
];
---

<section>
	<div class="cs-spacer-120"></div>
	<div class="cs-container">
		<h3 class="mb-6 text-center text-xl font-medium text-ink">Clientes que confían en nosotros</h3>
		<ul class="flex flex-wrap items-center justify-center gap-10">
			{
				clients.map((client) => (
					<li>
						<Image
							src={client.logo}
							alt={`Logo de ${client.name}`}
							class="h-20 w-auto object-contain"
							height={80}
							densities={[1, 2]}
							loading="lazy"
						/>
					</li>
				))
			}
		</ul>
	</div>
	<div class="cs-spacer-120"></div>
</section>
