---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { modules } from '../../data/content';
---

<section id="modulos" class="relative">
	<div class="cs-spacer-120"></div>
	<div class="cs-container">
		<div class="mx-auto mb-12 max-w-2xl text-center">
			<SectionEyebrow label="Módulos" class="justify-center" />
			<h2 class="cs-section-title mt-5">Un sistema, todos los módulos de tu laboratorio</h2>
			<p class="mt-5 leading-relaxed text-ash-700">
				Desde la recepción de la muestra hasta el cobro, cada área trabaja sobre la misma información.
			</p>
		</div>
		<ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				modules.map((module) => (
					<li class={`cs-card p-8 ${module.comingSoon ? 'border-dashed bg-paper' : ''}`}>
						<div class="flex items-center justify-between gap-3">
							<h3 class="text-xl font-semibold text-ink">{module.title}</h3>
							{module.comingSoon && (
								<span class="rounded-full bg-mint-300 px-3 py-1 text-xs font-semibold text-ink">Próximamente</span>
							)}
						</div>
						<p class="mt-3 leading-relaxed text-ash-700">{module.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
