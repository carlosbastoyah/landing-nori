# Google Tag Manager container (default: GTM-5T74VC56). GA4 is configured inside GTM.
# Leave it empty to disable tracking, e.g. on staging:
# PUBLIC_GTM_ID=

# Google Search Console → Etiqueta HTML → solo el valor de content="..."
# (Si verificas por DNS como "Propiedad de dominio", déjalo vacío)
PUBLIC_GOOGLE_SITE_VERIFICATION=
